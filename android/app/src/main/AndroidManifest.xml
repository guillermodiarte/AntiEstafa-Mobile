<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos de red para sincronización incremental -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Permiso para emitir alertas preventivas en Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".EscudoApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_shield"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_shield"
        android:supportsRtl="true"
        android:theme="@style/Theme.EscudoDigital">

        <!-- Pantalla principal: Protección Activa y Estado -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EscudoDigital">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de guía accesible de permisos -->
        <activity
            android:name=".ui.PermissionGuideActivity"
            android:exported="false"
            android:theme="@style/Theme.EscudoDigital" />

        <!-- Pantalla de detalle de alerta preventiva (Letra grande / Alto contraste) -->
        <activity
            android:name=".ui.AlertDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.EscudoDigital" />

        <!-- Servicio de escucha de notificaciones (WhatsApp y SMS) -->
        <service
            android:name=".notifications.ScamNotificationListener"
            android:exported="true"
            android:label="@string/service_notification_listener_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Servicio de filtrado de llamadas entrantes -->
        <service
            android:name=".calls.ScamCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

    </application>

</manifest>

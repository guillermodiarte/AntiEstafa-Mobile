<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Barra superior: título centrado + ícono de configuración -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/app_name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tvTitle"
                android:layout_centerHorizontal="true"
                android:text="Asistente Preventivo en Segundo Plano"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <!-- Ícono de configuración: ruedita arriba a la derecha -->
            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_settings"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Configuración"
                android:padding="8dp"
                android:tint="@color/text_secondary" />

        </RelativeLayout>

        <!-- Subtítulo debajo del header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asistente Preventivo en Segundo Plano"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="32dp"
            android:layout_marginTop="-24dp" />


        <!-- Tarjeta Principal de Protección (Diseño Adulto Mayor) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/bg_card"
            app:strokeColor="@color/border_card"
            app:strokeWidth="1dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/ivShieldStatus"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/ic_shield"
                    android:contentDescription="Escudo de Protección"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:id="@+id/tvProtectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Protección activa"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvProtectionDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Escudo Digital está funcionando y cuidando tus llamadas y mensajes."
                    android:textSize="18sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Estado de Servicios del Ecosistema -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:strokeColor="@color/border_card"
            app:strokeWidth="1dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Módulos en Segundo Plano"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp" />

                <!-- WhatsApp / SMS Listener -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Mensajes WhatsApp y SMS"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvNotificationStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activo"
                        android:textStyle="bold"
                        android:textColor="@color/shield_active"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Call Screening -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Filtrado de Llamadas"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvCallStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activo"
                        android:textStyle="bold"
                        android:textColor="@color/shield_active"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Protección Web en Navegadores (Accesibilidad) -->
                <LinearLayout
                    android:id="@+id/rowBrowserProtection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Protección Web (Chrome)"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvBrowserStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activo"
                        android:textStyle="bold"
                        android:textColor="@color/shield_active"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Base Local Offline -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Base Local Room (Offline)"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvDatabaseVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v10 (Al día)"
                        android:textStyle="bold"
                        android:textColor="@color/accent_cyan"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón de permisos: solo visible si falta algún permiso -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckPermissions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⚠️  Configurar Permisos del Sistema"
            android:textSize="14sp"
            app:cornerRadius="16dp"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="@color/text_secondary" />


    </LinearLayout>
</ScrollView>
